{
  "name": "@darkmoon_ai/client",
  "version": "0.2.0",
  "description": "Cross-version common client contract for Darkmoon OSS (CLI) and Darkmoon Pro (REST). Foundation for the 5 official integrations.",
  "license": "MIT",
  "author": "ASC-IT (SARL) — Darkmoon",
  "homepage": "https://github.com/ASCIT31/darkmoon-client#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ASCIT31/darkmoon-client.git"
  },
  "bugs": {
    "url": "https://github.com/ASCIT31/darkmoon-client/issues"
  },
  "keywords": [
    "darkmoon",
    "pentest",
    "security",
    "sast",
    "dast",
    "ci",
    "vulnerability"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "darkmoon-ci": "./dist/cli/darkmoon-ci.cjs"
  },
  "files": [
    "dist",
    "CONTRACT.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint \"src/**/*.ts\" \"cli/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:conformance": "vitest run test/conformance",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.0",
    "@types/node": "^22.5.0",
    "eslint": "^9.11.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.0"
  }
}
